<Application x:Class="LingoFluence.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:LingoFluence.Converters"
             StartupUri="Views/MainWindow.xaml">
    <Application.Resources>
        <!-- Converters -->
        <conv:BoolToVisConverter     x:Key="BoolToVis"/>
        <conv:BoolToVisConverter     x:Key="InvBoolToVis"       Invert="True"/>
        <conv:NullToVisConverter     x:Key="NullToVis"/>
        <conv:ZeroToCollapsedConverter x:Key="ZeroToCollapsed"/>
        <BooleanToVisibilityConverter  x:Key="BoolVis"/>

        <!-- Shadow effect -->
        <DropShadowEffect x:Key="CardShadow" BlurRadius="18" ShadowDepth="3"
                          Opacity="0.10" Direction="270" Color="Black"/>

        <!-- Colors -->
        <SolidColorBrush x:Key="PrimaryBrush"       Color="#4A90E2"/>
        <SolidColorBrush x:Key="BackgroundBrush"    Color="#EFF3F8"/>
        <SolidColorBrush x:Key="CardBrush"          Color="#FFFFFF"/>
        <SolidColorBrush x:Key="TextBrush"          Color="#2C3E50"/>
        <SolidColorBrush x:Key="SecondaryTextBrush" Color="#7F8C8D"/>
        <SolidColorBrush x:Key="SuccessBrush"       Color="#27AE60"/>
        <SolidColorBrush x:Key="DangerBrush"        Color="#E74C3C"/>
        <SolidColorBrush x:Key="WarningBrush"       Color="#E67E22"/>
        <SolidColorBrush x:Key="HintBrush"          Color="#8E44AD"/>

        <!-- Base button template -->
        <ControlTemplate x:Key="RoundedButtonTemplate" TargetType="Button">
            <Border x:Name="bd" Background="{TemplateBinding Background}"
                    CornerRadius="8" Padding="{TemplateBinding Padding}">
                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter TargetName="bd" Property="Opacity" Value="0.85"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter TargetName="bd" Property="Opacity" Value="0.70"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter TargetName="bd" Property="Opacity" Value="0.40"/>
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>

        <Style x:Key="BaseBtn" TargetType="Button">
            <Setter Property="Foreground"           Value="White"/>
            <Setter Property="FontSize"             Value="14"/>
            <Setter Property="FontWeight"           Value="SemiBold"/>
            <Setter Property="Padding"              Value="18,10"/>
            <Setter Property="BorderThickness"      Value="0"/>
            <Setter Property="Cursor"               Value="Hand"/>
            <Setter Property="Template"             Value="{StaticResource RoundedButtonTemplate}"/>
        </Style>
        <Style x:Key="PrimaryBtn"  TargetType="Button" BasedOn="{StaticResource BaseBtn}">
            <Setter Property="Background" Value="{StaticResource PrimaryBrush}"/>
        </Style>
        <Style x:Key="SuccessBtn"  TargetType="Button" BasedOn="{StaticResource BaseBtn}">
            <Setter Property="Background" Value="{StaticResource SuccessBrush}"/>
        </Style>
        <Style x:Key="DangerBtn"   TargetType="Button" BasedOn="{StaticResource BaseBtn}">
            <Setter Property="Background" Value="{StaticResource DangerBrush}"/>
        </Style>
        <Style x:Key="WarningBtn"  TargetType="Button" BasedOn="{StaticResource BaseBtn}">
            <Setter Property="Background" Value="{StaticResource WarningBrush}"/>
        </Style>
        <Style x:Key="HintBtn"     TargetType="Button" BasedOn="{StaticResource BaseBtn}">
            <Setter Property="Background" Value="{StaticResource HintBrush}"/>
        </Style>
        <Style x:Key="GhostBtn"    TargetType="Button" BasedOn="{StaticResource BaseBtn}">
            <Setter Property="Background" Value="#90A4AE"/>
        </Style>
        <!-- Header import button -->
        <Style x:Key="ImportBtn"   TargetType="Button" BasedOn="{StaticResource BaseBtn}">
            <Setter Property="Background" Value="#3578C8"/>
            <Setter Property="FontSize"   Value="13"/>
            <Setter Property="Padding"    Value="14,8"/>
        </Style>

        <!-- Round input -->
        <Style x:Key="StudyInput" TargetType="TextBox">
            <Setter Property="FontSize"        Value="22"/>
            <Setter Property="FontWeight"      Value="Bold"/>
            <Setter Property="Padding"         Value="12,8"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="BorderBrush"     Value="{StaticResource PrimaryBrush}"/>
            <Setter Property="Foreground"      Value="{StaticResource TextBrush}"/>
            <Setter Property="Background"      Value="White"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Application.Resources>
</Application>
