<Window x:Class="LingoFluence.Views.AiWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:LingoFluence.ViewModels"
        Title="🤖  AI Card Generator"
        Height="620" Width="880"
        Icon="/appicon.ico"
        Background="{StaticResource BackgroundBrush}"
        WindowStartupLocation="CenterScreen">
    <Window.DataContext><vm:AiViewModel/></Window.DataContext>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="56"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="{StaticResource PrimaryBrush}">
            <TextBlock Text="🤖  AI Card Generator" FontSize="18" FontWeight="Bold"
                       Foreground="White" VerticalAlignment="Center" Margin="24,0"/>
        </Border>

        <!-- Body -->
        <Grid Grid.Row="1" Margin="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="260"/>
            </Grid.ColumnDefinitions>

            <!-- Left: chat log + deck name + request input -->
            <Grid Grid.Column="0" Margin="0,0,12,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Chat log -->
                <Border Grid.Row="0" Background="White" CornerRadius="10"
                        Effect="{StaticResource CardShadow}" Margin="0,0,0,10">
                    <ScrollViewer x:Name="ChatScroller" Padding="14"
                                  VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding ChatMessages}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding}" TextWrapping="Wrap"
                                               Margin="0,3" FontSize="13"
                                               Foreground="{StaticResource TextBrush}"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Border>

                <!-- Deck name row -->
                <Grid Grid.Row="1" Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="130"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Margin="0,0,8,0">
                        <TextBlock Text="Deck name" FontSize="11"
                                   Foreground="{StaticResource SecondaryTextBrush}" Margin="2,0,0,3"/>
                        <TextBox Text="{Binding DeckName, UpdateSourceTrigger=PropertyChanged}"
                                 FontSize="13" Padding="10,8"
                                 Background="White" BorderBrush="{StaticResource PrimaryBrush}" BorderThickness="1">
                            <TextBox.Resources>
                                <Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style>
                            </TextBox.Resources>
                        </TextBox>
                    </StackPanel>
                    <Button Grid.Column="1" Content="📥  Import Deck"
                            Command="{Binding ImportCommand}"
                            Style="{StaticResource SuccessBtn}" FontSize="13"
                            Padding="0,8" VerticalAlignment="Bottom"/>
                </Grid>

                <!-- Request input + Generate -->
                <Grid Grid.Row="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="130"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Margin="0,0,8,0">
                        <TextBlock Text="What flashcards do you want to create?" FontSize="11"
                                   Foreground="{StaticResource SecondaryTextBrush}" Margin="2,0,0,3"/>
                        <TextBox x:Name="RequestBox"
                                 Text="{Binding UserRequest, UpdateSourceTrigger=PropertyChanged}"
                                 FontSize="13" Padding="10,8"
                                 Background="White" BorderBrush="{StaticResource PrimaryBrush}" BorderThickness="1"
                                 KeyDown="RequestBox_KeyDown">
                            <TextBox.Resources>
                                <Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style>
                            </TextBox.Resources>
                        </TextBox>
                    </StackPanel>
                    <Button Grid.Column="1" Content="✨  Generate"
                            Command="{Binding GenerateCommand}"
                            Style="{StaticResource PrimaryBtn}" FontSize="13"
                            Padding="0,8" VerticalAlignment="Bottom"/>
                </Grid>
            </Grid>

            <!-- Right: card preview panel -->
            <Border Grid.Column="1" Background="White" CornerRadius="10"
                    Effect="{StaticResource CardShadow}" Padding="14">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Text="PREVIEW" FontSize="10" FontWeight="Bold"
                               Foreground="{StaticResource SecondaryTextBrush}" Margin="0,0,0,8"/>
                    <ListBox Grid.Row="1" ItemsSource="{Binding CardPreviews}"
                             Background="Transparent" BorderThickness="0"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                <Setter Property="Padding" Value="4,2"/>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="0,3">
                                    <TextBlock Text="{Binding German}" FontWeight="SemiBold"
                                               FontSize="13" Foreground="{StaticResource TextBrush}"/>
                                    <TextBlock Text="{Binding English}" FontSize="11"
                                               Foreground="{StaticResource SecondaryTextBrush}"
                                               TextWrapping="Wrap"/>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>
        </Grid>

        <!-- Loading overlay -->
        <Border Grid.RowSpan="2" Background="#AA000000"
                Visibility="{Binding IsGenerating, Converter={StaticResource BoolToVis}}">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <TextBlock Text="⏳  Generating…" FontSize="22" Foreground="White"
                           FontWeight="Bold" HorizontalAlignment="Center"/>
                <TextBlock Text="This may take a moment." FontSize="14"
                           Foreground="White" Opacity="0.75" Margin="0,10,0,0"
                           HorizontalAlignment="Center"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
