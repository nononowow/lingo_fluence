<Window x:Class="LingoFluence.Views.AiStudyWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{Binding DeckTitle}"
        Height="580" Width="680"
        Icon="/appicon.ico"
        Background="{StaticResource BackgroundBrush}"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <!-- One vocabulary or phrase row of a story card's back face. -->
        <DataTemplate x:Key="StoryEntryTemplate">
            <Grid Margin="0,0,0,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="{Binding Headword}" FontSize="14.5" FontWeight="SemiBold"
                               TextWrapping="Wrap"
                               Foreground="{StaticResource TextBrush}"/>
                    <TextBlock Text="{Binding Meaning}" FontSize="13" TextWrapping="Wrap"
                               Margin="0,2,0,0"
                               Foreground="{StaticResource SecondaryTextBrush}"/>
                </StackPanel>
                <Button Grid.Column="1" Content="🔊" ToolTip="Speak"
                        Tag="{Binding De}" Click="SpeakDE_Click"
                        Style="{StaticResource GhostBtn}" Padding="7,3"
                        Margin="8,0,0,0" VerticalAlignment="Top"/>
                <Button Grid.Column="2" Content="📋" ToolTip="Copy with meanings"
                        Tag="{Binding CopyText}" Click="Copy_Click"
                        Style="{StaticResource GhostBtn}" Padding="7,3"
                        Margin="4,0,0,0" VerticalAlignment="Top"/>
            </Grid>
        </DataTemplate>
    </Window.Resources>
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Progress bar -->
        <Grid Grid.Row="0" Margin="0,0,0,16">
            <ProgressBar Height="8" Value="{Binding Progress, Mode=OneWay}" Maximum="1"
                         Foreground="{StaticResource PrimaryBrush}"
                         Background="#DDE8F5" BorderThickness="0"/>
            <TextBlock Text="{Binding ProgressText}"
                       HorizontalAlignment="Right" VerticalAlignment="Top"
                       FontSize="12" Margin="0,-18,0,0"
                       Foreground="{StaticResource SecondaryTextBrush}"/>
        </Grid>

        <!-- FRONT (word card): German word, large -->
        <Border Grid.Row="1"
                Visibility="{Binding IsFrontWord, Converter={StaticResource BoolToVis}}"
                Background="White" CornerRadius="16" Effect="{StaticResource CardShadow}">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="32">
                <TextBlock Text="{Binding GermanText}"
                           FontSize="52" FontWeight="Bold"
                           Foreground="{StaticResource TextBrush}"
                           TextAlignment="Center" TextWrapping="Wrap"/>
                <!-- IPA phonetic transcription -->
                <TextBlock Text="{Binding IpaText}" FontSize="22"
                           Foreground="{StaticResource SecondaryTextBrush}"
                           TextAlignment="Center" Margin="0,12,0,0"
                           Visibility="{Binding HasIpa, Converter={StaticResource BoolToVis}}"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,24,0,0">
                    <Button Content="🔊  Speak" Click="SpeakGerman_Click"
                            Style="{StaticResource GhostBtn}" Padding="20,8"/>
                    <Button Content="ˈɪ  音标" Command="{Binding FetchIpaCommand}"
                            Style="{StaticResource GhostBtn}" Padding="20,8" Margin="10,0,0,0"
                            Visibility="{Binding CanFetchIpa, Converter={StaticResource BoolToVis}}"/>
                    <TextBlock Text="⏳" FontSize="18" VerticalAlignment="Center" Margin="10,0,0,0"
                               Visibility="{Binding IsFetchingIpa, Converter={StaticResource BoolToVis}}"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- FRONT (story card): title + full readable text + playback controls -->
        <Border Grid.Row="1"
                Visibility="{Binding IsFrontStory, Converter={StaticResource BoolToVis}}"
                Background="White" CornerRadius="16" Effect="{StaticResource CardShadow}"
                Padding="28">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <!-- Topic: German title, its translations, and the same speak/translate/
                     copy controls every other German text in the app gets. -->
                <Grid Grid.Row="0" Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="{Binding StoryTitleDe}" FontSize="24" FontWeight="Bold"
                                   Foreground="{StaticResource PrimaryBrush}" TextWrapping="Wrap"/>
                        <TextBlock Text="{Binding TitleTranslation}" FontSize="15" TextWrapping="Wrap"
                                   Margin="0,4,0,0"
                                   Foreground="{StaticResource SecondaryTextBrush}"
                                   Visibility="{Binding HasTitleTranslation, Converter={StaticResource BoolToVis}}"/>
                    </StackPanel>
                    <Button Grid.Column="1" Content="🔊" ToolTip="Speak the topic"
                            Tag="{Binding StoryTitleDe}" Click="SpeakDE_Click"
                            Style="{StaticResource GhostBtn}" Padding="10,5" Margin="8,0,0,0"
                            VerticalAlignment="Center"/>
                    <Button Grid.Column="2" Content="🌐" ToolTip="Translate the topic (EN + 中文)"
                            Command="{Binding FetchTitleCommand}"
                            Style="{StaticResource GhostBtn}" Padding="10,5" Margin="4,0,0,0"
                            VerticalAlignment="Center"
                            Visibility="{Binding CanFetchTitle, Converter={StaticResource BoolToVis}}"/>
                    <TextBlock Grid.Column="3" Text="⏳" FontSize="16" Margin="6,0,0,0"
                               VerticalAlignment="Center"
                               Visibility="{Binding IsFetchingTitle, Converter={StaticResource BoolToVis}}"/>
                    <Button Grid.Column="4" Content="📋" ToolTip="Copy the topic with translations"
                            Tag="{Binding TitleCopyText}" Click="Copy_Click"
                            Style="{StaticResource GhostBtn}" Padding="10,5" Margin="4,0,0,0"
                            VerticalAlignment="Center"/>
                </Grid>
                <!-- One row per sentence: "Sentence N:" heading, German, speak + copy.
                     Translations stay hidden here and appear on the back. -->
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                  <StackPanel>
                    <!-- The whole story as one block, for reading and full-text TTS -->
                    <Border Background="#F4F1FA" CornerRadius="10" Padding="16,14"
                            Margin="0,0,0,14"
                            Visibility="{Binding HasStoryParagraph, Converter={StaticResource BoolToVis}}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="{Binding StoryParagraph}" FontSize="18"
                                       LineHeight="30" TextWrapping="Wrap"
                                       Foreground="{StaticResource TextBrush}"/>
                            <Button Grid.Column="1" Content="🔊" ToolTip="Read the whole story"
                                    Tag="{Binding StoryParagraph}" Click="SpeakDE_Click"
                                    Style="{StaticResource GhostBtn}" Padding="9,4"
                                    Margin="10,0,0,0" VerticalAlignment="Top"/>
                            <Button Grid.Column="2" Content="📋" ToolTip="Copy the whole story"
                                    Tag="{Binding StoryParagraph}" Click="Copy_Click"
                                    Style="{StaticResource GhostBtn}" Padding="9,4"
                                    Margin="4,0,0,0" VerticalAlignment="Top"/>
                        </Grid>
                    </Border>
                    <TextBlock Text="Sentence Breakdown · 逐句解析" FontSize="13" FontWeight="SemiBold"
                               Margin="0,0,0,8"
                               Foreground="{StaticResource SecondaryTextBrush}"
                               Visibility="{Binding HasStoryLines, Converter={StaticResource BoolToVis}}"/>
                    <ItemsControl ItemsSource="{Binding StoryLines}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="#FAFAFC" CornerRadius="8" Padding="12,9"
                                        Margin="0,0,0,6">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="{Binding Label}" FontSize="12"
                                                       FontWeight="SemiBold" Margin="0,0,0,4"
                                                       Foreground="{StaticResource SecondaryTextBrush}"/>
                                            <TextBlock Text="{Binding De}" FontSize="18"
                                                       LineHeight="28" TextWrapping="Wrap"
                                                       Foreground="{StaticResource TextBrush}"/>
                                        </StackPanel>
                                        <Button Grid.Column="1" Content="🔊" ToolTip="Speak this sentence"
                                                Tag="{Binding De}" Click="SpeakDE_Click"
                                                Style="{StaticResource GhostBtn}" Padding="9,4"
                                                Margin="8,0,0,0" VerticalAlignment="Top"/>
                                        <Button Grid.Column="2" Content="📋" ToolTip="Copy this sentence"
                                                Tag="{Binding De}" Click="Copy_Click"
                                                Style="{StaticResource GhostBtn}" Padding="9,4"
                                                Margin="4,0,0,0" VerticalAlignment="Top"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </StackPanel>
                </ScrollViewer>
                <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center"
                            Margin="0,14,0,0">
                    <Button Content="🔊  Read all" Tag="{Binding StoryParagraph}" Click="SpeakDE_Click"
                            Style="{StaticResource GhostBtn}" Padding="20,8"
                            ToolTip="Reads the whole story"/>
                    <Button Content="⏹  Stop" Click="Stop_Click"
                            Style="{StaticResource GhostBtn}" Padding="20,8" Margin="10,0,0,0"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- BACK (story card): the same sentence rows, each with its translations -->
        <Border Grid.Row="1"
                Visibility="{Binding IsBackStory, Converter={StaticResource BoolToVis}}"
                Background="White" CornerRadius="16" Effect="{StaticResource CardShadow}"
                Padding="28">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid Grid.Row="0" Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="{Binding StoryTitleDe}" FontSize="20" FontWeight="Bold"
                                   Foreground="{StaticResource PrimaryBrush}" TextWrapping="Wrap"/>
                        <TextBlock Text="{Binding TitleTranslation}" FontSize="14" TextWrapping="Wrap"
                                   Margin="0,3,0,0"
                                   Foreground="{StaticResource SecondaryTextBrush}"
                                   Visibility="{Binding HasTitleTranslation, Converter={StaticResource BoolToVis}}"/>
                    </StackPanel>
                    <Button Grid.Column="1" Content="🔊" ToolTip="Speak the topic"
                            Tag="{Binding StoryTitleDe}" Click="SpeakDE_Click"
                            Style="{StaticResource GhostBtn}" Padding="10,5" Margin="8,0,0,0"
                            VerticalAlignment="Center"/>
                    <Button Grid.Column="2" Content="🌐" ToolTip="Translate the topic (EN + 中文)"
                            Command="{Binding FetchTitleCommand}"
                            Style="{StaticResource GhostBtn}" Padding="10,5" Margin="4,0,0,0"
                            VerticalAlignment="Center"
                            Visibility="{Binding CanFetchTitle, Converter={StaticResource BoolToVis}}"/>
                    <TextBlock Grid.Column="3" Text="⏳" FontSize="16" Margin="6,0,0,0"
                               VerticalAlignment="Center"
                               Visibility="{Binding IsFetchingTitle, Converter={StaticResource BoolToVis}}"/>
                    <Button Grid.Column="4" Content="📋" ToolTip="Copy the topic with translations"
                            Tag="{Binding TitleCopyText}" Click="Copy_Click"
                            Style="{StaticResource GhostBtn}" Padding="10,5" Margin="4,0,0,0"
                            VerticalAlignment="Center"/>
                </Grid>
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                  <StackPanel>
                    <ItemsControl ItemsSource="{Binding StoryLines}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="#FAFAFC" CornerRadius="8" Padding="12,10"
                                        Margin="0,0,0,8">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="{Binding Label}" FontSize="12"
                                                       FontWeight="SemiBold" Margin="0,0,0,4"
                                                       Foreground="{StaticResource SecondaryTextBrush}"/>
                                            <TextBlock Text="{Binding De}" FontSize="17" LineHeight="26"
                                                       TextWrapping="Wrap"
                                                       Foreground="{StaticResource TextBrush}"/>
                                            <TextBlock Text="{Binding En}" FontSize="14" FontStyle="Italic"
                                                       TextWrapping="Wrap" Margin="0,4,0,0"
                                                       Foreground="{StaticResource SecondaryTextBrush}"
                                                       Visibility="{Binding HasEn, Converter={StaticResource BoolToVis}}"/>
                                            <TextBlock Text="{Binding Zh}" FontSize="14"
                                                       TextWrapping="Wrap" Margin="0,3,0,0"
                                                       Foreground="{StaticResource PrimaryBrush}"
                                                       Visibility="{Binding HasZh, Converter={StaticResource BoolToVis}}"/>
                                            <TextBlock Text="{Binding Structure}" FontSize="12.5"
                                                       TextWrapping="Wrap" Margin="0,6,0,0"
                                                       Foreground="{StaticResource SecondaryTextBrush}"
                                                       Visibility="{Binding HasStructure, Converter={StaticResource BoolToVis}}"/>
                                            <!-- The words and phrases of THIS sentence -->
                                            <StackPanel Margin="0,8,0,0"
                                                        Visibility="{Binding HasWords, Converter={StaticResource BoolToVis}}">
                                                <TextBlock Text="Words in this sentence · 本句词汇"
                                                           FontSize="11.5" FontWeight="SemiBold"
                                                           Margin="0,0,0,4"
                                                           Foreground="{StaticResource SecondaryTextBrush}"/>
                                                <ItemsControl ItemsSource="{Binding WordList}"
                                                              ItemTemplate="{StaticResource StoryEntryTemplate}"/>
                                            </StackPanel>
                                            <StackPanel Margin="0,8,0,0"
                                                        Visibility="{Binding HasPhrases, Converter={StaticResource BoolToVis}}">
                                                <TextBlock Text="Phrases in this sentence · 本句短语"
                                                           FontSize="11.5" FontWeight="SemiBold"
                                                           Margin="0,0,0,4"
                                                           Foreground="{StaticResource SecondaryTextBrush}"/>
                                                <ItemsControl ItemsSource="{Binding PhraseList}"
                                                              ItemTemplate="{StaticResource StoryEntryTemplate}"/>
                                            </StackPanel>
                                        </StackPanel>
                                        <Button Grid.Column="1" Content="🔊" ToolTip="Speak this sentence"
                                                Tag="{Binding De}" Click="SpeakDE_Click"
                                                Style="{StaticResource GhostBtn}" Padding="9,4"
                                                Margin="8,0,0,0" VerticalAlignment="Top"/>
                                        <Button Grid.Column="2" Content="📋"
                                                ToolTip="Copy sentence with translations"
                                                Tag="{Binding CopyText}" Click="Copy_Click"
                                                Style="{StaticResource GhostBtn}" Padding="9,4"
                                                Margin="4,0,0,0" VerticalAlignment="Top"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- Vocabulary: every distinct word of the story -->
                    <StackPanel Margin="0,10,0,0"
                                Visibility="{Binding HasStoryVocab, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="Full Vocabulary List · 全部词汇" FontSize="13" FontWeight="SemiBold"
                                   Margin="0,0,0,6"
                                   Foreground="{StaticResource SecondaryTextBrush}"/>
                        <ItemsControl ItemsSource="{Binding StoryVocab}"
                                      ItemTemplate="{StaticResource StoryEntryTemplate}"/>
                    </StackPanel>

                    <!-- Phrases, idioms and collocations -->
                    <StackPanel Margin="0,14,0,0"
                                Visibility="{Binding HasStoryPhrases, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="Full Phrases &amp; Idioms List · 全部短语" FontSize="13" FontWeight="SemiBold"
                                   Margin="0,0,0,6"
                                   Foreground="{StaticResource SecondaryTextBrush}"/>
                        <ItemsControl ItemsSource="{Binding StoryPhrases}"
                                      ItemTemplate="{StaticResource StoryEntryTemplate}"/>
                    </StackPanel>
                  </StackPanel>
                </ScrollViewer>
                <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center"
                            Margin="0,14,0,0">
                    <Button Content="🔊  Read all" Tag="{Binding ExampleDe}" Click="SpeakDE_Click"
                            Style="{StaticResource GhostBtn}" Padding="20,8"/>
                    <Button Content="⏹  Stop" Click="Stop_Click"
                            Style="{StaticResource GhostBtn}" Padding="20,8" Margin="10,0,0,0"/>
                    <Button Content="📋  Copy story" Tag="{Binding StoryCopyText}" Click="Copy_Click"
                            Style="{StaticResource GhostBtn}" Padding="20,8" Margin="10,0,0,0"
                            ToolTip="Copy every sentence with its translations"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- BACK (word card): meaning + grammar + examples -->
        <Border Grid.Row="1"
                Visibility="{Binding IsBackWord, Converter={StaticResource BoolToVis}}"
                Background="White" CornerRadius="16" Effect="{StaticResource CardShadow}"
                Padding="28">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <!-- German heading + speak + copy -->
                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding GermanText}" FontSize="26" FontWeight="Bold"
                                   Foreground="{StaticResource PrimaryBrush}" TextWrapping="Wrap" VerticalAlignment="Center"/>
                        <Button Grid.Column="1" Content="🔊" Click="SpeakGerman_Click"
                                Style="{StaticResource GhostBtn}" Padding="10,5" Margin="8,0,0,0"/>
                        <Button Grid.Column="2" Content="📋" ToolTip="Copy" Tag="{Binding GermanText}" Click="Copy_Click"
                                Style="{StaticResource GhostBtn}" Padding="10,5" Margin="4,0,0,0"/>
                    </Grid>
                    <!-- IPA phonetic transcription + on-demand fetch -->
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <TextBlock Text="{Binding IpaText}" FontSize="16" VerticalAlignment="Center"
                                   Foreground="{StaticResource SecondaryTextBrush}"
                                   Visibility="{Binding HasIpa, Converter={StaticResource BoolToVis}}"/>
                        <Button Content="ˈɪ  音标" Command="{Binding FetchIpaCommand}"
                                Style="{StaticResource GhostBtn}" Padding="10,5"
                                Visibility="{Binding CanFetchIpa, Converter={StaticResource BoolToVis}}"/>
                        <TextBlock Text="⏳  正在获取音标…" FontSize="13" VerticalAlignment="Center"
                                   Foreground="{StaticResource SecondaryTextBrush}"
                                   Visibility="{Binding IsFetchingIpa, Converter={StaticResource BoolToVis}}"/>
                    </StackPanel>
                    <!-- English meaning + copy -->
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding EnglishText}" FontSize="18"
                                   Foreground="{StaticResource TextBrush}" TextWrapping="Wrap" VerticalAlignment="Center"/>
                        <Button Grid.Column="1" Content="📋" ToolTip="Copy" Tag="{Binding EnglishText}" Click="Copy_Click"
                                Style="{StaticResource GhostBtn}" Padding="8,2" FontSize="13" Margin="8,0,0,0"/>
                    </Grid>
                    <!-- Chinese meaning + copy -->
                    <Grid Margin="0,0,0,8"
                          Visibility="{Binding HasChinese, Converter={StaticResource BoolToVis}}">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding ChineseText}" FontSize="18"
                                   Foreground="{StaticResource PrimaryBrush}" TextWrapping="Wrap" VerticalAlignment="Center"/>
                        <Button Grid.Column="1" Content="📋" ToolTip="Copy" Tag="{Binding ChineseText}" Click="Copy_Click"
                                Style="{StaticResource GhostBtn}" Padding="8,2" FontSize="13" Margin="8,0,0,0"/>
                    </Grid>
                    <!-- On-demand Chinese fetch (older cards generated before the Chinese field existed) -->
                    <Button Content="🌐  获取中文" Command="{Binding FetchChineseCommand}"
                            Style="{StaticResource GhostBtn}" Padding="10,5" HorizontalAlignment="Left"
                            Margin="0,0,0,8"
                            Visibility="{Binding CanFetchChinese, Converter={StaticResource BoolToVis}}"/>
                    <TextBlock Text="⏳  正在获取中文…" FontSize="13"
                               Foreground="{StaticResource SecondaryTextBrush}" Margin="0,0,0,8"
                               Visibility="{Binding IsFetchingChinese, Converter={StaticResource BoolToVis}}"/>
                    <!-- Grammar note -->
                    <TextBlock Text="{Binding GrammarText}" FontSize="13" FontStyle="Italic"
                               Foreground="{StaticResource SecondaryTextBrush}" TextWrapping="Wrap"
                               Visibility="{Binding HasGrammar, Converter={StaticResource BoolToVis}}"
                               Margin="0,0,0,14"/>
                    <Separator Background="#E0E0E0" Margin="0,0,0,14"
                               Visibility="{Binding HasExampleDe, Converter={StaticResource BoolToVis}}"/>
                    <!-- Example DE (or, on a story card, the full story text) + speak + copy -->
                    <Grid Margin="0,0,0,6"
                          Visibility="{Binding HasExampleDe, Converter={StaticResource BoolToVis}}">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding ExampleDe}" FontSize="14" TextWrapping="Wrap"
                                   VerticalAlignment="Center" Foreground="{StaticResource TextBrush}"/>
                        <Button Grid.Column="1" Content="🔊" Tag="{Binding ExampleDe}" Click="SpeakDE_Click"
                                Style="{StaticResource GhostBtn}" Padding="10,5" Margin="8,0,0,0"/>
                        <Button Grid.Column="2" Content="📋" ToolTip="Copy" Tag="{Binding ExampleDe}" Click="Copy_Click"
                                Style="{StaticResource GhostBtn}" Padding="8,2" FontSize="13" Margin="4,0,0,0"/>
                    </Grid>
                    <!-- Example EN + speak + copy -->
                    <Grid Visibility="{Binding HasExampleEn, Converter={StaticResource BoolToVis}}">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding ExampleEn}" FontSize="14" FontStyle="Italic"
                                   Foreground="{StaticResource SecondaryTextBrush}" TextWrapping="Wrap" VerticalAlignment="Center"/>
                        <Button Grid.Column="1" Content="🔊" Tag="{Binding ExampleEn}" Click="SpeakEN_Click"
                                Style="{StaticResource GhostBtn}" Padding="10,5" Margin="8,0,0,0"/>
                        <Button Grid.Column="2" Content="📋" ToolTip="Copy" Tag="{Binding ExampleEn}" Click="Copy_Click"
                                Style="{StaticResource GhostBtn}" Padding="8,2" FontSize="13" Margin="4,0,0,0"/>
                    </Grid>
                    <!-- Example DE → Chinese translation + copy -->
                    <Grid Margin="0,8,0,0"
                          Visibility="{Binding HasExampleZh, Converter={StaticResource BoolToVis}}">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding ExampleZh}" FontSize="14"
                                   Foreground="{StaticResource PrimaryBrush}" TextWrapping="Wrap" VerticalAlignment="Center"/>
                        <Button Grid.Column="1" Content="📋" ToolTip="Copy" Tag="{Binding ExampleZh}" Click="Copy_Click"
                                Style="{StaticResource GhostBtn}" Padding="8,2" FontSize="13" Margin="8,0,0,0"/>
                    </Grid>
                    <!-- On-demand Chinese fetch for the German example sentence -->
                    <Button Content="🌐  例句中文" Command="{Binding FetchExampleZhCommand}"
                            Style="{StaticResource GhostBtn}" Padding="10,5" HorizontalAlignment="Left"
                            Margin="0,8,0,0"
                            Visibility="{Binding CanFetchExampleZh, Converter={StaticResource BoolToVis}}"/>
                    <TextBlock Text="⏳  正在获取中文…" FontSize="13"
                               Foreground="{StaticResource SecondaryTextBrush}" Margin="0,8,0,0"
                               Visibility="{Binding IsFetchingExampleZh, Converter={StaticResource BoolToVis}}"/>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- FINISHED overlay -->
        <Border Grid.Row="1"
                Visibility="{Binding IsFinished, Converter={StaticResource BoolToVis}}"
                Background="White" CornerRadius="16" Effect="{StaticResource CardShadow}">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <TextBlock Text="🎉" FontSize="64" HorizontalAlignment="Center"/>
                <TextBlock Text="Session complete!" FontSize="24" FontWeight="Bold"
                           Foreground="{StaticResource TextBrush}" HorizontalAlignment="Center" Margin="0,12,0,6"/>
                <TextBlock Text="{Binding ProgressText}" FontSize="14"
                           Foreground="{StaticResource SecondaryTextBrush}" HorizontalAlignment="Center"/>
            </StackPanel>
        </Border>

        <!-- REVEAL button (front state) -->
        <Button Grid.Row="2" Content="{Binding RevealText}"
                Command="{Binding FlipCommand}"
                Style="{StaticResource PrimaryBtn}"
                Visibility="{Binding IsFront, Converter={StaticResource BoolToVis}}"
                Padding="0,14" FontSize="15" Margin="0,16,0,0"/>

        <!-- GRADE buttons (back state, not finished) -->
        <UniformGrid Grid.Row="2" Columns="2"
                     Visibility="{Binding CanGrade, Converter={StaticResource BoolToVis}}"
                     Margin="0,16,0,0">
            <Button Content="↩  Again" Command="{Binding GradeAgainCommand}"
                    Style="{StaticResource DangerBtn}" Padding="0,14" FontSize="15" Margin="0,0,8,0"/>
            <Button Content="✓  Good"  Command="{Binding GradeGoodCommand}"
                    Style="{StaticResource SuccessBtn}" Padding="0,14" FontSize="15" Margin="8,0,0,0"/>
        </UniformGrid>

        <!-- CLOSE button (finished state) -->
        <Button Grid.Row="2" Content="Close" Click="Close_Click"
                Style="{StaticResource GhostBtn}"
                Visibility="{Binding IsFinished, Converter={StaticResource BoolToVis}}"
                Padding="0,14" FontSize="15" Margin="0,16,0,0"/>

        <!-- ── Copy toast ── -->
        <Border x:Name="Toast" Grid.RowSpan="3"
                Background="#CC1F2937" CornerRadius="20" Padding="20,10"
                HorizontalAlignment="Center" VerticalAlignment="Bottom"
                Margin="0,0,0,40" Opacity="0" Visibility="Collapsed"
                Panel.ZIndex="10">
            <TextBlock x:Name="ToastText" Foreground="White" FontSize="13" FontWeight="SemiBold"/>
        </Border>
    </Grid>
</Window>
